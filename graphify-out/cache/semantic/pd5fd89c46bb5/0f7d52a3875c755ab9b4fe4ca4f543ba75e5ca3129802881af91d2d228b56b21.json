{"nodes": [{"id": "_github_workflows_release", "label": "Release Workflow", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cancel-in-progress is false (#178): a release tag does not move, so cancelling mid-flight could leave a release with partial assets; duplicate runs re-upload with --clobber harmlessly."}, {"id": "_github_workflows_release_validate_release_tag", "label": "Release Tag Validation (strict X.Y.Z = package.json)", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The '[0-9]*' tag glob matches malformed tags; every step reads VERSION from package.json, so a mismatched tag would silently publish a wrongly named release (issue #220)."}, {"id": "_github_workflows_release_changelog_release_notes", "label": "Release Notes from CHANGELOG.md", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub's PR-based generated notes came back empty because the repo pushed straight to main; a CHANGELOG entry is mandatory and the step fails loudly without one."}, {"id": "_github_workflows_release_unsigned_windows_installer", "label": "Unsigned Windows NSIS Installer", "file_type": "rationale", "source_file": ".github/workflows/release.yml", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post-2023 CA/Browser Forum rules put code-signing keys on hardware tokens or cloud HSMs, so signing needs a signing-service integration (e.g. SignPath); the build warns but never fails. NSIS only: no Partner Center account for AppX and electron-updater ignores AppX."}, {"id": "_github_workflows_release_windows_auto_update_assets", "label": "Windows Auto-Update Assets (latest.yml + .exe.blockmap)", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "electron-updater's NSIS updater needs latest.yml and the blockmap; verification fails loudly instead of shipping a release nothing can auto-update from."}, {"id": "scripts_changelog_notes", "label": "changelog-notes.sh", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog", "label": "CHANGELOG.md", "file_type": "document", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_uninstallers_uninstall_windows", "label": "uninstall-windows.ps1", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_release", "target": "_github_workflows_release_validate_release_tag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release.yml", "source_location": "L31", "weight": 1.0}, {"source": "_github_workflows_release", "target": "_github_workflows_release_changelog_release_notes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release.yml", "source_location": "L53", "weight": 1.0}, {"source": "_github_workflows_release", "target": "_github_workflows_release_windows_auto_update_assets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release.yml", "source_location": "L143", "weight": 1.0}, {"source": "_github_workf