{"nodes": [{"id": "docs_api_mdns_buonapp_local", "label": "mDNS advertisement buonapp.local", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_standalone_kds_3002", "label": "Standalone KDS server (:3002)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enabled by default; with kds_enabled switched off, /api/kds-info, /api/kitchen/* and /api/kds/* answer 403."}, {"id": "docs_api_auth_login", "label": "POST /api/auth/login (JWT, rememberMe)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rememberMe makes the token last 10 days instead of 24 hours; tenants always holds the one local business, which the frontend selects on its own."}, {"id": "docs_api_kds_server_app_login", "label": "KDS and Server App login routes (role-gated)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The KDS admits chef, manager and owner and returns station_ids with a 24-hour token; the Server App admits only server, with remember_me for 10 days; neither counts failed attempts, bound only by the shared authentication rate limit."}, {"id": "docs_api_login_lockout", "label": "Login lockout (5 attempts, 15 minutes)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "attempts_remaining counts down the 5 attempts allowed per address; the fifth failure carries lockout_minutes 15 and further attempts answer 429 until the time is up."}, {"id": "docs_api_role_based_access", "label": "Role-based access (owner, manager, cashier, server, chef)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1513", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_user_management", "label": "Staff user management (/api/users, /api/staff)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner or manager token; a manager manages only operational staff (cashier, server, chef), only an owner changes roles, and the last active owner can be neither demoted nor deactivated; a new password or PIN ends the account's open sessions."}, {"id": "docs_api_staff_never_deleted", "label": "Staff accounts deactivated, never deleted", "file_type": "rationale", "source_file": "docs/API.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orders and print logs refer to staff accounts, so accounts are deactivated instead of deleted."}, {"id": "docs_api_username_login", "label": "Username-based login (migration v96)", "file_type": "rationale", "source_file": "docs/API.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BuonApp sends no mail, so an email was only an invented identifier; migration v96 turned each one into the part before the @. The username is matched regardless of case, surrounding spaces and accents, and stored lowercase with accents folded."}, {"id": "docs_api_kds_category_filtering", "label": "KDS category filtering for chefs", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1525", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_kds_websocket", "label": "KDS WebSocket /kds protocol", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1055", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_business_settings", "label": "Business settings (timezone, currency, localeOptions)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1268", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locale display preferences are validated and normalized against the active country's localeOptions; timezone is validated as an IANA identifier; tax_registration_number is printed verbatim on the bill header and nothing computes with it."}, {"id": "docs_api_discount_after_check_changes", "label": "Discount after the check changes (percentage recomputed, euros kept)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L905", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A percentage is recomputed on the new food total, while a discount in euros (amount or total) stays what was agreed and never exceeds the food left on the check."}, {"id": "docs_api_discount_new_total", "label": "New-total order discount (discount_type total, target_total)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L879", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server works out the discount against the order as it stands under the transaction lock, so an item added meanwhile moves the discount, not the total; it is computed from the undiscounted check so a second rounding replaces the first, and it cannot go below the cover and other charges because a discount only comes off the food."}, {"id": "docs_api_discount_settings", "label": "Discount settings (/api/settings/discount, discount_methods)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1298", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "discount_methods lists the switched-on ways to discount (total, percentage, amount) in button order, never empty and without repeats; the discount window opens on the first."}, {"id": "docs_api_discounts", "label": "Order, item and bill discounts with limits", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L863", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The new total is offered only on the order discount; item and bill discounts take percentage or amount; every method must be switched on in discount_methods, and discount_requires_approval demands an override_pin."}, {"id": "docs_api_manager_pin_override", "label": "Manager/owner PIN override", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L916", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_order_status_transitions", "label": "Order status transition matrix", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L697", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reservations_endpoints", "label": "Reservations endpoints", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L431", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_table_layouts_endpoints", "label": "Floor plan endpoints (/api/table-layouts)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L492", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_idempotency_key", "label": "Idempotency-Key retry-safe create and append", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L672", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A retry of the same user's identical request returns the order it made and is answered before anything else is checked, so an order whose answer was lost still comes back after a dish, add-on or order type has been switched off; reusing the key for a different body returns 409 idempotency_conflict, and a 5xx means an unknown outcome to be retried with the same key."}, {"id": "docs_api_kot_batch", "label": "order_items.kot_batch round ledger", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1420", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_menu_group_course_put", "label": "PUT /orders/:id/menu-groups/:groupId/courses/:courseId", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L954", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "product_ids is what the course holds afterwards, so one endpoint adds, swaps and clears and replaying the same list changes nothing; new rows are born with kot_batch NULL and go out on the next round; a dish the kitchen has already started returns 409 course_in_progress and nothing is written."}, {"id": "docs_api_order_create", "label": "POST /api/orders (guest_count, service_run, menu_selection)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L628", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "user_id is never read from the body: the order is stamped with the authenticated caller; add-on names and prices are resolved from the catalog and client-supplied ones ignored."}, {"id": "docs_api_print_kot_endpoint", "label": "POST /api/printers/print-kot", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1418", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only never-sent rows go out, stamped with the next round and routed to the kitchen stations; batch re-prints a round without a new number; nothing pending answers 200 printed:false; servers may call it because on a handheld sending the order is firing the ticket, while print-bill stays closed to them."}, {"id": "docs_api_server_app_3003", "label": "Server App for handhelds (:3003)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_service_run_endpoint", "label": "PATCH /orders/:id/items/:itemId/service-run", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L937", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any waiter on any order, and no manager PIN since no money moves. Runs are labels, not gates: kot_batch is deliberately untouched, so a row already printed still moves and nothing is re-sent."}, {"id": "docs_api_server_app_allowlist", "label": "Server App narrow forwarding allowlist", "file_type": "rationale", "source_file": "docs/API.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The handheld gets only the catalogue, read-only settings, rooms and tables, the order routes a waiter needs (create, append, guests, service-run, menu-groups) and print-kot; no table write, bill, payment or customer route is forwarded, and everything else under /api answers 404."}, {"id": "docs_api_held_orders", "label": "Held orders (/api/held-orders)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L716", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE consumes a held order only when heldOrderId matches the current row, so an already-consumed or replaced row is never deleted and the table is not released by a stale request."}, {"id": "docs_api_reports", "label": "Reports summary and sales (UTC dates)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The owner dashboard is gone; a service day's close summary is where a restaurant reads its numbers, and what remains is the money read side over UTC date ranges."}, {"id": "docs_api_rooms_endpoints", "label": "Rooms endpoints (/api/rooms)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L379", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A room is not deleted while it still holds tables (409 room_not_empty), rather than scattering a floor plan or deleting the tables behind one click."}, {"id": "docs_api_service_days_endpoints", "label": "Service Days endpoints", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L514", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_tables_endpoints", "label": "Tables endpoints (/api/tables)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L330", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting a table is real and history survives through each order's table_label/room_label snapshot; it is refused with 409 table_has_open_order or table_has_held_cart while something live still points at it."}, {"id": "docs_api", "label": "BuonApp API Documentation (docs/API.md)", "file_type": "document", "source_file": "docs/API.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_customer_erase", "label": "DELETE /api/customers/:id hard erase", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The row is removed, not flagged inactive; orders, bills, held orders, reservations and WhatsApp messages keep their amounts and only lose the link, while the loyalty ledger is deleted with the customer."}, {"id": "docs_api_customers_endpoints", "label": "Customers endpoints (customers_disabled switch)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L1147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /api/customers answers 403 customers_disabled when the customers_enabled setting is off and the business keeps no customer book."}, {"id": "docs_api_item_cancel_void", "label": "Order item cancel / void (void_adjustment)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L792", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An item in preparing or ready is voided with a negative void_adjustment bill line and a manager PIN instead of restoring stock; on a fixed menu cancelling the package row takes the whole menu off the check and a dish row only that dish, and restore follows the same split."}, {"id": "docs_api_product_image_route", "label": "GET /api/products/:id/image (tokenless dish photo)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one route the Server App serves without a token: the dish photo for the menu's img, open for the same reason as on :3001 and passed through byte for byte with its ETag."}, {"id": "docs_api_auth_rate_limit", "label": "Authentication rate limit (10 requests / 15 min per address)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared by every authentication route, and by creating or changing a staff account."}, {"id": "docs_api_only_if_table_free", "label": "only_if_table_free guard (open the table only if still free)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L674", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dine-in with a table_id only: an open dine-in order on the table answers 409 table_has_open_order with order_id and order_number, a table that no longer exists 409 table_not_found; nothing is written under the key, so the caller can send the same dishes to POST /orders/:id/items with a key of its own. The handheld sends it on every order it opens."}, {"id": "docs_api_order_append", "label": "POST /api/orders/:id/items (append to an open order)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L813", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Items take the same shape as on create; any waiter may append to any open order and the order keeps the user_id of whoever opened it; a completed or cancelled order refuses new items with order_closed."}, {"id": "docs_api_order_refusal_codes", "label": "Order route refusal codes (invalid_item, insufficient_stock, order_closed, table_has_open_order, table_not_found, idempotency_conflict)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L676", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refusals carry a code a client can act on: invalid_item (400) for a dish, add-on, quantity or price the order cannot take, insufficient_stock (409), order_closed (400), order_not_found (404), table_has_open_order and table_not_found (409), idempotency_conflict (409)."}, {"id": "docs_api_order_rate_limits", "label": "Per-account order route rate limits (60 writes, 120 reads a minute)", "file_type": "concept", "source_file": "docs/API.md", "source_location": "L678", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counted per signed-in account because the handhelds all reach the API from 127.0.0.1 through the Server App, and counted per address they shared one budget with each other and the till."}], "edges": [{"source": "docs_api_customers_endpoints", "target": "docs_api_customer_erase", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L1173", "weight": 1.0}, {"source": "docs_api_discount_after_check_changes", "target": "docs_api_discount_new_total", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L906", "weight": 1.0}, {"source": "docs_api_discounts", "target": "docs_api_discount_new_total", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L879", "weight": 1.0}, {"source": "docs_api_discounts", "target": "docs_api_discount_after_check_changes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L905", "weight": 1.0}, {"source": "docs_api_idempotency_key", "target": "docs_api_order_create", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L672", "weight": 1.0}, {"source": "docs_api_kds_server_app_login", "target": "docs_api_auth_login", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L76", "weight": 1.0}, {"source": "docs_api_kds_server_app_login", "target": "docs_api_server_app_3003", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L76", "weight": 1.0}, {"source": "docs_api_kds_server_app_login", "target": "docs_api_standalone_kds_3002", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L76", "weight": 1.0}, {"source": "docs_api_order_create", "target": "docs_api_service_run_endpoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L635", "weight": 1.0}, {"source": "docs_api_reports", "target": "docs_table_management_service_days", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L1219", "weight": 1.0}, {"source": "docs_api_rooms_endpoints", "target": "docs_api_tables_endpoints", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L385", "weight": 1.0}, {"source": "docs_api_service_days_endpoints", "target": "docs_api_held_orders", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L555", "weight": 1.0}, {"source": "docs_api_service_days_endpoints", "target": "docs_api_tables_endpoints", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L560", "weight": 1.0}, {"source": "docs_api_staff_never_deleted", "target": "docs_api_role_based_access", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L102", "weight": 1.0}, {"source": "docs_api_tables_endpoints", "target": "docs_api_reservations_endpoints", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L434", "weight": 1.0}, {"source": "readme_express_api", "target": "docs_api_mdns_buonapp_local", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/API.md", "source_location": "L7", "weight": 1.0}, {"source": "docs_api_auth_login", "target": "docs_api_login_lockout", "relation": "implements", "confidence": "EXTRACTED", "con