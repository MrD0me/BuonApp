ll, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE is refused (409) with table_has_open_order or table_has_held_cart; the table_is_merged code went away with joined tables."}, {"id": "docs_api_rooms_endpoints", "label": "Rooms endpoints (/api/rooms)", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_reservations_endpoints", "label": "Reservations endpoints", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigning a booking to a held table is the same call as a plain assignment: whatever was on the target inherits what this booking had, and the response carries displaced."}, {"id": "docs_api_table_layouts_endpoints", "label": "Floor plan endpoints (/api/table-layouts)", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_service_days_endpoints", "label": "Service Days endpoints", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_order_create", "label": "POST /api/orders (guest_count, service_run, menu_selection)", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add-on names and prices resolve from the catalog, client-supplied ones are ignored; user_id is never read from the body but stamped from the authenticated caller."}, {"id": "docs_api_order_status_transitions", "label": "Order status transition matrix", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null,