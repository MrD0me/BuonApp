{"nodes": [{"id": "docs_palmare", "label": "Il palmare (Server App)", "file_type": "document", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_palmare_server_app", "label": "Server App tableside handheld", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_palmare_server_app_access", "label": "ServerAppAccess QR codes", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moved into the PC sidebar item \"Palmari\" (a modal over the current screen) so a cashier, who cannot see Settings, can show it to a new waiter."}, {"id": "docs_palmare_sala_view", "label": "Sala view (table list, natural order)", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A list rather than the map: on a six-inch screen a scaled room shrinks and scrolls sideways, and a waiter standing at the table does not need its position."}, {"id": "docs_palmare_table_screen", "label": "TableScreen (full page table view)", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A full page with a back arrow replaced the drawer, which had no close button and had to be unmounted whenever the menu window opened on the same layer."}, {"id": "docs_palmare_ordina_view", "label": "OrdinaView product list (photo, pencil, stepper)", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_palmare_proxy", "label": "Server App proxy (main/server-app.ts)", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_palmare_product_image_passthrough", "label": "Unauthenticated product image passthrough with ETag", "file_type": "rationale", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An <img> cannot carry a token; the main API already leaves the same route open, so the passthrough only brings the bytes onto the page origin allowed by its CSP. Dot-only ids are rejected."}, {"id": "docs_palmare_no_cash", "label": "Handheld has no cash, table writes, customers or takeaway", "file_type": "rationale", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bills, payments, discounts and line prices stay on the central PC beside the till; tables (status, reservations, map) are written only from the PC. The doc still lists \"unioni\" (table joins) among table writes although joining tables was removed in migration v97."}, {"id": "docs_palmare_every_waiter_every_table", "label": "Every waiter on every table (ownership constraint dropped)", "file_type": "rationale", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The handheld taking the main course is not the one that took the starter, so the seven ownership guards were dropped; per-route requireRole stays, and orders.user_id is still stamped from the token."}, {"id": "docs_palmare_derived_append_target", "label": "Derived append-target order", "file_type": "rationale", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The order the cart appends to is read fresh from the cart's table on every render, so switching table cannot send a round to the wrong check (lesson of commit ffb52ad)."}, {"id": "docs_palmare_idempotent_replay", "label": "Interrupted send replay (order-attempt / append-attempt)", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_palmare_direct_to_ticket", "label": "Products without options go straight to the ticket (lib/product-options.ts)", "file_type": "rationale", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Water has nothing to decide, and a window for every dish was an extra tap all evening; the pencil still opens note and quantity."}, {"id": "docs_palmare_handheld_data", "label": "useHandheldData polling (catalogue, settings, rooms, open orders)", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polls every 15 s while visible; rows come from GET /orders rather than from tables, because rows tell whether a round is pending."}, {"id": "docs_palmare_no_lib_api_import", "label": "Handheld never imports @/lib/api", "file_type": "rationale", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PC API client's 401 interceptor would send the handheld back to the PC login; the handheld uses its own server-api.ts client."}, {"id": "docs_palmare_shared_pos_modals", "label": "POS windows mounted unchanged (AddonModal, FixedMenuPicker, AttachToMenuModal, ServiceRunPicker)", "file_type": "concept", "source_file": "docs/palmare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The windows were written props-in/callbacks-out on components/ui/modal (bottom sheet under 768 px) so they mount on the handheld untouched, together with the shared UI primitives."}], "edges": [{"source": "docs_palmare", "target": "docs_table_management", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/palmare.md", "source_location": null, "weight": 1}, {"source": "docs_palmare", "target": "docs_coperto_e_menu_fisso", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/palmare.md", "source_location": null, "weight": 1}, {"source": "docs_palmare_proxy", "target": "docs_palmare_product_image_passthrough", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/palmare.md", "source_location": null, "weight": 1}, {"source": "docs_palmare_proxy", "target": "docs_table_management_device_boundary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/palmare.md", "source_location": null, "weight": 1}, {"source": "docs_palmare_server_app", "target": "docs_palmare_ordina_view", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/palmare.md", "source_location": null, "weight": 1}, {"source": "docs_palmare_server_app", "target": "docs_palmare_proxy", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/palmare.md", "source_location": null, "weight": 1}, {"source": "docs_palmare_server_app", "target": "docs_palmare_sala_view", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/palmare.md", "source_location": null, "weight": 1}, {"source": "docs_palmare_server_app", "target": "docs_palmare_table_screen", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/palmare.md", "source_location": null, "weight": 1}, {"sou