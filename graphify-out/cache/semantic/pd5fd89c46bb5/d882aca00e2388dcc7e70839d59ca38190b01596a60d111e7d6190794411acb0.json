{"nodes": [{"id": "docs_printers_receipt_language", "label": "Receipt language (English/Italian)", "file_type": "concept", "source_file": "docs/printers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_printers_ticket_layout", "label": "Kitchen ticket layout and dish folding", "file_type": "concept", "source_file": "docs/printers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers follow the table in double height because the floor calls a table by its number and party size together; the order's own note prints in bold before the first dish on every station's ticket so an allergy is read before anything is cooked; one quantity-column width for the whole ticket keeps a 10 in line; nothing is drawn between categories or between dishes because every line drawn across a run was read as the start of the next run, and the double-height name already shows where a dish starts. Identical dishes fold unless product, add-ons, note, variants or run differ; the closing line and piece count plus order number let the pass check the ticket."}, {"id": "docs_printers_connection_types", "label": "Printer connection types (Network, USB/OS queue, WebUSB)", "file_type": "concept", "source_file": "docs/printers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_printers_windows_raw_spooler", "label": "Windows spooler RAW/winprint requirement", "file_type": "concept", "source_file": "docs/printers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_printers_wpc1252", "label": "WPC1252 code page for accented characters", "file_type": "concept", "source_file": "docs/printers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_printers_ki