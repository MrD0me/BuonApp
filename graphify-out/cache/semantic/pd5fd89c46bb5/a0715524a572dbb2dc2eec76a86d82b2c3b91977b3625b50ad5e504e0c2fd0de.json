{"nodes": [{"id": "docs_api", "label": "Local API Reference (docs/API.md)", "file_type": "document", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_mdns_buonapp_local", "label": "mDNS advertisement buonapp.local", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_standalone_kds_3002", "label": "Standalone KDS server (:3002)", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_server_app_3003", "label": "Server App for handhelds (:3003)", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_server_app_allowlist", "label": "Server App narrow forwarding allowlist", "file_type": "rationale", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The handheld gets only the catalogue, read-only settings/rooms/tables, the order routes a waiter needs and print-kot; no table write, bill, payment or customer route is forwarded, everything else under /api answers 404."}, {"id": "docs_api_auth_login", "label": "POST /api/auth/login (JWT)", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_username_login", "label": "Username-based login (migration v96)", "file_type": "rationale", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BuonApp sends no mail, so an email was only an invented identifier; migration