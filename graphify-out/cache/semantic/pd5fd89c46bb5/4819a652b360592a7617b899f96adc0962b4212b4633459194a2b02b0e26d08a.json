{"nodes": [{"id": "readme_cloud_bridge_removal", "label": "Cloud Bridge & Telemetry Removal (4.0.0, migration v80)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "cloud bridge & telemetry removal (4.0.0, migration v80)", "rationale": "The cloud bridge that registered the installation with a vendor dashboard and the anonymous telemetry beside it were removed in 4.0.0 (service, outbox tables, settings and stored credentials alike); migration v80 clears them from existing databases and restoring an old backup does not bring them back.", "source_file": "README.md", "source_location": "L106", "source_url": null}, {"id": "readme_data_protection", "label": "Data Protection (pre-migration backups, restore, health checks)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "data protection (pre-migration backups, restore, health checks)", "rationale": "A timestamped backup is taken automatically before every schema migration; the database and local backups live in the operating-system user-data directory, separate from the installed binaries, and survive in-place updates, though a manual backup is advised before reinstalling or moving machines.", "source_file": "README.md", "source_location": "L67", "source_url": null}, {"id": "readme_flo_desktop_migration", "label": "Upgrade from Flo Cafe (flo-desktop user-data copy)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "upgrade from flo cafe (flo-desktop user-data copy)", "rationale": "On first launch BuonApp copies an existing flo-desktop user-data directory into its own, so an install that predates the rename keeps its database, backups, Google Drive token, Master PIN and WhatsApp session; the old directory is copied, not moved, so rolling back to an older build still finds its data.", "source_file": "README.md", "source_location": "L108", "source_url": null}, {"id": "readme_flocafe_fork", "label": "Fork of FloCafe (diverged since)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "fork of flocafe (diverged since)", "rationale": "BuonApp began as a fork of FloCafe and has diverged since: the cloud bridge and telemetry are gone, the dining room is a map with service days and reservations, kitchen tickets print by round, and the interface was redrawn for a touch screen at the till. It keeps the copyright of the FloCafe contributors under the MIT License.", "source_file": "README.md", "source_location": "L24", "source_url": null}, {"id": "readme_google_drive_backup", "label": "Optional Google Drive Backup", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "optional google drive backup", "rationale": "Reaches the network only once the owner configures and enables it, and fails gracefully when offline.", "source_file": "README.md", "source_location": "L109", "source_url": null}, {"id": "readme_update_check", "label": "In-App Update Check (this repository's GitHub releases)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "in-app update check (this repository's github releases)", "rationale": "Besides the owner-enabled Google Drive backup, the update check against this repository's own releases is the only thing that reaches the network; in-app updates work from the first install on.", "source_file": "README.md", "source_location": "L28", "source_url": null}, {"id": "readme_windows_only_releases", "label": "Windows-Only Published Releases", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "rationale", "norm_label": "windows-only published releases", "rationale": "Signing and store credentials the fork does not have used to fail the release job and take the Windows installer down with them; macOS and Linux still build from source. The Windows installer is not code-signed, so SmartScreen asks once (More info, Run anyway).", "source_file": "README.md", "source_location": "L30", "source_url": null}, {"id": "readme_express_api", "label": "Express API and WebSocket Server (:3001)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "express api and websocket server (:3001)", "source_file": "README.md", "source_location": "L149", "source_url": null}, {"id": "readme_kds_server", "label": "Standalone Kitchen Display Server (:3002)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "standalone kitchen display server (:3002)", "rationale": "Optional, for kitchens that work off a screen instead of paper; it can be switched off entirely, which closes its endpoints.", "source_file": "README.md", "source_location": "L63", "source_url": null}, {"id": "readme_mdns_buonapp_local", "label": "mDNS Advertisement as buonapp.local", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "mdns advertisement as buonapp.local", "source_file": "README.md", "source_location": "L110", "source_url": null}, {"id": "readme_server_app_handheld", "label": "Tableside Server App for Handhelds (:3003)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "tableside server app for handhelds (:3003)", "rationale": "A phone joins by scanning the code under Handhelds in the till's sidebar and signs in with a waiter's own account; it shows a read-only floor, then the menu with a stepper beside each dish and the till's own windows for extras, fixed menus and service runs. Any waiter can work any open order; sending fires the kitchen ticket exactly as the till does, and handhelds take no money and cannot change the floor.", "source_file": "README.md", "source_location": "L62", "source_url": null}, {"id": "readme_preconto", "label": "Preconto (non-fiscal bill)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "preconto (non-fiscal bill)", "rationale": "BuonApp computes no taxes: an item costs what the menu says and the bill is the sum of what was ordered plus the cover; in several countries a fiscal receipt must come from certified hardware, so the printed document is only a preconto, and a business registration number in the header is identity, not a tax figure.", "source_file": "README.md", "source_location": "L126", "source_url": null}, {"id": "readme_staff_roles", "label": "Staff Roles, Username Sign-in & Manager PIN Overrides", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "staff roles, username sign-in & manager pin overrides", "rationale": "Owner, Manager, Cashier, Server and Chef sign in with a username and a password, not an email, since nothing in BuonApp sends mail; manager PIN overrides cover voids and cancellations, and a print log is kept per bill.", "source_file": "README.md", "source_location": "L66", "source_url": null}, {"id": "readme_ui_languages", "label": "UI Translations (en, it, es, pt-BR, fa with RTL)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "ui translations (en, it, es, pt-br, fa with rtl)", "rationale": "UI language is independent of the store's country and regional settings; receipts and kitchen tickets follow the UI language in English or Italian and fall back to English for the other three, rather than printing a half-translated bill.", "source_file": "README.md", "source_location": "L114", "source_url": null}, {"id": "readme_cover_charge", "label": "Cover Charge", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "cover charge", "rationale": "A price per cover, set once, carried by every dine-in order by head count and printed on the preconto; a new order's covers start from the booking's party or the table's seats; changing the covers on an open order re-prices it, and the printed line spells out 'Cover 4 x 2,00' only when that multiplication really gives the amount.", "source_file": "README.md", "source_location": "L58", "source_url": null}, {"id": "readme_floor_map", "label": "Dining Room as a Map (rooms, table shapes, saved floor plans)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "dining room as a map (rooms, table shapes, saved floor plans)", "rationale": "Rooms are real entities drawn as floor plans rather than card grids; a large party is seated by changing the map in edit mode, not by joining tables; in service the map is fitted to the screen, a booked table writes whose it is and how many are coming, and a floor plan saved by name can be re-applied on a later evening.", "source_file": "README.md", "source_location": "L53", "source_url": null}, {"id": "readme_reservations", "label": "Reservations (the service day in front of you, name + head count)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "reservations (the service day in front of you, name + head count)", "rationale": "A booking can be taken before anyone decides where it sits, waiting in a row above the map; assigning it to a table that is already booked swaps the two bookings in a single move, and a party asking for another table is moved from the table's own card.", "source_file": "README.md", "source_location": "L55", "source_url": null}, {"id": "readme_service_days", "label": "Service Days", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "service days", "rationale": "Orders are filed under an explicit service day instead of a UTC date so a service running past midnight stays one evening; the day opens by itself on the first order, and the close refuses to start while orders are open or bills unpaid unless the owner forces it and writes down why, freezes the totals before touching anything, then clears the floor and, if asked, deletes the tables.", "source_file": "README.md", "source_location": "L54", "source_url": null}, {"id": "readme_kitchen_tickets_by_round", "label": "Kitchen Tickets by Round & Service Runs", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "kitchen tickets by round & service runs", "rationale": "Sending prints only the rows never sent before, numbered as a sequential round; each dish carries a service run taken from its category and movable by the floor, and the ticket is sectioned by run; identical dishes fold into one line unless they carry a note; rows are routed to the station that owns their category, and a station that fails to print keeps its rows queued for the next send.", "source_file": "README.md", "source_location": "L60", "source_url": null}, {"id": "readme_thermal_printing", "label": "Thermal ESC/POS Printing (USB, TCP 9100, OS queues, WebUSB)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "thermal esc/pos printing (usb, tcp 9100, os queues, webusb)", "rationale": "A kitchen ticket always prints from the backend, which owns the rounds and the stations, while WebUSB in a browser serves bills only; a WPC1252 code page prints accented characters and the euro sign as written.", "source_file": "README.md", "source_location": "L61", "source_url": null}, {"id": "readme_whatsapp_bill_delivery", "label": "WhatsApp Bill Delivery (switched off)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "whatsapp bill delivery (switched off)", "rationale": "Still in the code but switched off by WHATSAPP_AVAILABLE in main/features.ts and frontend/src/lib/features.ts: no screen offers it and its service never starts.", "source_file": "README.md", "source_location": "L109", "source_url": null}, {"id": "docs_google_drive_setup", "label": "Google Drive Backup Setup (docs/google-drive-setup.md)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "document", "norm_label": "google drive backup setup (docs/google-drive-setup.md)", "source_file": "README.md", "source_location": "L179", "source_url": null}, {"id": "docs_linux", "label": "Linux Installation Guide (docs/linux.md)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "document", "norm_label": "linux installation guide (docs/linux.md)", "source_file": "README.md", "source_location": "L177", "source_url": null}, {"id": "docs_printers", "label": "Printer Guide (docs/printers.md)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "document", "norm_label": "printer guide (docs/printers.md)", "source_file": "README.md", "source_location": "L171", "source_url": null}, {"id": "readme", "label": "README.md", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "document", "norm_label": "readme.md", "source_file": "README.md", "source_location": "L1", "source_url": null}, {"id": "readme_optional_customer_book", "label": "Optional Customer Book Switch", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "optional customer book switch", "rationale": "The customer list, the loyalty wallet and the till's customer field are one switch in Settings; a restaurant that keeps only reservations turns them off and the write endpoints close with them.", "source_file": "README.md", "source_location": "L65", "source_url": null}, {"id": "readme_fixed_menus", "label": "Fixed Menus (counted, one price)", "_origin": "semantic", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "rationale": "Rung up the way the floor writes it on the pad: how many menus, then how many of each dish, without asking who eats what. One line carries the number and the price; under it the menu writes real rows, one per portion, so the kitchen ticket sections them by category and a portion can carry its own note, written once for all the plates that share it, while the bill folds identical ones into 'Lasagne 3'. A menu that includes the cover takes its guests off the cover charge; cancelling the menu row removes the whole menu, cancelling a dish only that dish.", "source_file": "README.md", "source_location": "L59", "source_url": null}, {"id": "readme_handheld_draft_reload", "label": "Half-written handheld ticket survives a reload", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "half-written handheld ticket survives a reload", "source_file": "README.md", "source_location": "L62", "source_url": null}, {"id": "readme_handheld_offline_send", "label": "Handheld keeps the ticket when the Wi-Fi drops", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "handheld keeps the ticket when the wi-fi drops", "rationale": "A phone that drops off the Wi-Fi keeps the ticket and sends it by itself when the PC answers again.", "source_file": "README.md", "source_location": "L62", "source_url": null}, {"id": "readme_one_order_one_bill", "label": "One Order, One Bill (check splitting removed in 5.0.0)", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "one order, one bill (check splitting removed in 5.0.0)", "rationale": "Splitting a check between guests was removed in 5.0.0: who among the party pays what is settled at the till, while paying one bill with several methods is a different thing and stays.", "source_file": "README.md", "source_location": "L128", "source_url": null}, {"id": "readme_discounts", "label": "Discounts (percentage, flat amount, new total)", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "discounts (percentage, flat amount, new total)", "rationale": "Per item or on the whole check; each of the three ways is switched on or off in Settings. The new total is what the table is told ('it's 53.40, call it 50'), with round figures to tap and the discount worked out by the server; a maximum percentage and a maximum amount cap them, a manager PIN can be required, and a discount given by mistake can be taken off.", "source_file": "README.md", "source_location": "L57", "source_url": null}, {"id": "readme_order_workflows", "label": "Order Workflows (dine-in, takeaway, delivery)", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "order workflows (dine-in, takeaway, delivery)", "rationale": "Only the order types the house actually takes; carts held on a table and shared across devices; open-price rows. An order is drawn up, cashed and reprinted from one place (the table on the floor plan, or the day's list for takeaway and delivery); with table service the ordering screen composes and sends and takes no money, because the till is the machine beside the computer.", "source_file": "README.md", "source_location": "L56", "source_url": null}, {"id": "readme_screenshot_gallery", "label": "A Look Around (screenshot gallery)", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "a look around (screenshot gallery)", "rationale": "Seven screenshots from a test database with the interface in Italian, the language of the restaurant it runs in: the floor map, a table card, Order, the booking sheet, Today, the handheld and two kitchen-ticket rounds.", "source_file": "README.md", "source_location": "L69", "source_url": null}, {"id": "readme_status_colours", "label": "Shared Status Colours (green free, red occupied, amber booked, orange to send)", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "shared status colours (green free, red occupied, amber booked, orange to send)", "rationale": "The same colours mean the same thing on every screen and on the handheld.", "source_file": "README.md", "source_location": "L71", "source_url": null}, {"id": "readme_system_requirements", "label": "System Requirements (Windows 10+, 1024x768 touch display, 4 GB RAM)", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "system requirements (windows 10+, 1024x768 touch display, 4 gb ram)", "rationale": "Windows 10 or later (macOS 12+ and current Linux build from source), a 1024x768 or larger display designed for a touch monitor, 4 GB RAM, 500 MB plus room for backups, and a private LAN only if handhelds, a kitchen display or network printers are used; Node.js is needed only to develop.", "source_file": "README.md", "source_location": "L39", "source_url": null}, {"id": "readme_touch_interface", "label": "Touch Interface Redrawn in 6.0.0", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "touch interface redrawn in 6.0.0", "rationale": "The till is a touch monitor, so every target is at least 44 px and nothing depends on hovering; the sidebar holds Floor, Order, Today, Menu and Archive with Handhelds and Settings at its foot; on a 1024x768 screen the window opens at 90% zoom so every page fits.", "source_file": "README.md", "source_location": "L71", "source_url": null}, {"id": "readme_catalog", "label": "Catalog (products, categories, add-on groups, fixed menus, CSV import/export)", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "norm_label": "catalog (products, categories, add-on groups, fixed menus, csv import/export)", "source_file": "README.md", "source_location": "L64", "source_url": null}], "edges": [{"source": "readme_ui_languages", "target": "readme_thermal_printing", "relation": "conceptually_related_to", "_origin": "semantic", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L122", "weight": 1.0}, {"source": "readme_update_check", "target": "readme_windows_only_releases", "relation": "conceptually_related_to", "_origin": "semantic", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L28", "weight": 1.0}, {"source": "readme", "target": "docs_google_drive_setup", "relation": "references", "_origin": "semantic", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L179", "weight": 1.0}, {"source": "readme_ui_languages", "target": "docs_i18n", "relation": "references", "_origin": "semantic", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L122", "weight": 1.0}, {"source": "readme_order_workflows", "target": "main_services_discounts_discountfortargettotal", "relation": "conceptually_related_to", "_origin": "semantic", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_cover_charge", "target": "docs_api_order_create", "relation": "conceptually_related_to", "_origin": "semantic", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "L58", "weight": 1.0}, {"source": "readme_fixed_menus", "target": "docs_api_item_cancel_void", "relation": "conceptually_related_to", "_origin": "semantic", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "L59", "weight": 1.0}, {"source": "readme_floo