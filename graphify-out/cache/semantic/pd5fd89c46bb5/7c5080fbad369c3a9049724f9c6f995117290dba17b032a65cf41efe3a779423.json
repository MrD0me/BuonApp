{"nodes": [{"id": "docs_rifacimento_grafica", "label": "Rifacimento grafico", "file_type": "document", "source_file": "docs/rifacimento-grafica.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CURRENT, done 2026-09-16/17 on branch rifacimento-grafica after mockup approval; it followed order-flow-and-navigation because repainting over a confused architecture does not remove the confusion."}, {"id": "docs_rifacimento_grafica_touch_targets", "label": "Touch targets 44/48/56 px", "file_type": "rationale", "source_file": "docs/rifacimento-grafica.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The central PC is an old touch cash monitor used mostly by finger and the handheld is a phone: minimum 44 px, 48 for an action, 56 for the main one, no hover-only affordances, state written in words as well as colour; exposed as --spacing-touch tokens (h-touch, min-h-touch-lg, size-touch)."}, {"id": "docs_rifacimento_grafica_window_work_area", "label": "createWindow sized to workAreaSize (1024x768 cash screen)", "file_type": "rationale", "source_file": "docs/rifacimento-grafica.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A window asking 1400x900 is not shrunk to the screen it is born on, so the till saw only its top-left corner; the 768 minimum height also hid the status bar and the Exit row under the taskbar."}, {"id": "docs_rifacimento_grafica_small_screen_zoom", "label": "Page zoom on small screens (webPreferences.zoomFactor)", "file_type": "rationale", "source_file": "docs/rifacimento-grafica.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even with the right window the UI, designed at ~1140x800, came out a size too large on the 1024x768 till; zoom 90% there, 5% steps, never under 75% so a 44 px button stays at the 40 px Windows touch minimum."}, {"id": "docs_rifacimento_grafica_status_styles", "label": "Status colors in one place (status-styles.ts)", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously five copies of the same idea agreeing by luck; held is violet so it does not resemble the brand blue; status colours are not the interface colour (mockup variant A: the blue stays)."}, {"id": "docs_rifacimento_grafica_z_layers", "label": "Declared z layers (panel 50, modal 60, confirm 70)", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything was at 50 and whichever mounted later won, which is why the handheld unmounted the table drawer to show the menu window."}, {"id": "docs_rifacimento_grafica_ui_primitives", "label": "UI primitives (modal, side-panel, page-header, stepper, status-badge, segmented-control, action-bar, empty-state)", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modal on radix Dialog gives focus trap, Esc, scroll lock and announced title that hand-written fixed inset-0 windows lacked; bottom sheet under 768 px, centred card above."}, {"id": "docs_rifacimento_grafica_page_toolbar", "label": "PageToolbar shared page header", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same header everywhere (toggle, title, actions); the title is the same word as the sidebar entry."}, {"id": "docs_rifacimento_grafica_sidebar", "label": "Sidebar with 48 px rows, collapse toggle in page header", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Collapse entry was a menu item leading nowhere; collapsed, each entry is its icon centred with the name in the tooltip (half a letter peeked out until 2026-09-24)."}, {"id": "docs_rifacimento_grafica_service_day_chip", "label": "ServiceDayChip in page header", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_floor_side_panel", "label": "Floor table panel as 672 px SidePanel", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a wide screen the room stays visible beside it; at 1024 px only a strip remains under the shadow, so there it is effectively a window."}, {"id": "docs_rifacimento_grafica_order_panel_pieces", "label": "OrderPanel split into header/lines/sheet/totals/action bar", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The three 16 px icons per row were untouchable by finger and indistinguishable at a glance; a row tap now opens a sheet with run, price, remove, void."}, {"id": "docs_rifacimento_grafica_ordina_layout", "label": "Ordina: table heads the ticket, compact tiles counted on grid width", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Columns counted on the space the grid really has, not the window, because the ticket takes 320-384 px and one column too many truncates every name."}, {"id": "docs_rifacimento_grafica_giornata_list", "label": "Giornata orders as a list opening the shared order panel", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each order used to be a full panel with all its actions in a grid: a wall."}, {"id": "docs_rifacimento_grafica_product_form_fields", "label": "Product form still asks supermarket fields (SKU, barcode, cost, stock)", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_dark_theme", "label": "Dark theme tokens unused", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_map_min_scale", "label": "Map MIN_SCALE 0.7 with overflow scroll", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written when MIN_SCALE 0.45 lost the euro total by 1.2 px on a 1024 monitor. Stale against current code: 6.2.1 made the map fit width and height and RoomMap.tsx now has MIN_SCALE = 0.3."}, {"id": "docs_rifacimento_grafica_rtl_check_lists", "label": "Hand-written RTL check lists", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": "L157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The RTL test lists are written by hand: a new interface file must be added or it is not checked."}], "edges": [{"source": "docs_rifacimento_grafica", "target": "docs_order_flow_and_navigation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1