{"nodes": [{"id": "docs_rifacimento_grafica", "label": "Rifacimento grafico", "file_type": "document", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_sidebar", "label": "Sidebar with 48 px rows, collapse toggle in page header", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_dark_theme", "label": "Dark theme tokens unused", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_floor_side_panel", "label": "Floor table panel as 672 px SidePanel", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a wide screen the room stays visible beside it; at 1024 px only a strip remains under the shadow, so there it is effectively a window."}, {"id": "docs_rifacimento_grafica_sala_tiles", "label": "Sala: room selector, legend yielding to bookings, status-band tiles", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rooms as a segmented selector, a colour legend that gives way to bookings still to place, tiles with a status band, written label and 'N da inviare' badge; a booked table writes the booking name and party over seats."}, {"id": "docs_rifacimento_grafica_giornata_list", "label": "Giornata orders as a list opening the shared order panel", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_ordina_layout", "label": "Ordina: table heads the ticket, compact tiles counted on grid width", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_product_form_fields", "label": "Product form still asks supermarket fields (SKU, barcode, cost, stock)", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_rtl_check_lists", "label": "Hand-written RTL check lists", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_small_screen_zoom", "label": "Page zoom on small screens (webPreferences.zoomFactor)", "file_type": "rationale", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UI was drawn and tested at about 1140x800; on the 1024x768 till everything came out a size bigger. Zoom is set in 5% steps, never under 75% (90% on the till), keeping a 44 px button at 40 px, Windows' touch minimum."}, {"id": "docs_rifacimento_grafica_order_panel_pieces", "label": "OrderPanel split into header/lines/sheet/totals/action bar", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_status_styles", "label": "Status colors in one place (status-styles.ts)", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_ui_primitives", "label": "UI primitives (modal, side-panel, stepper, status-badge, segmented-control, action-bar, empty-state)", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_page_toolbar", "label": "PageToolbar shared page header", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_map_min_scale", "label": "Map MIN_SCALE 0.7 with overflow scroll", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 0.45 a four-top on a medium room at 1024 px was drawn at 74.8 px against the 76 needed for the second line, so the euro total vanished from every table. A round table asks 96 px. For huge rooms the honest answer is a list like the handheld's, not a scale tweak."}, {"id": "docs_rifacimento_grafica_service_day_chip", "label": "ServiceDayChip in page header", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_z_layers", "label": "Declared z layers (panel 50, modal 60, confirm 70)", "file_type": "concept", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rifacimento_grafica_touch_targets", "label": "Touch targets 44/48/56 px", "file_type": "rationale", "source_file": "docs/rifacimento-grafica.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributo